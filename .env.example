# Ednaficator environment (copy to .env in repo root)

# LLM provider: lmstudio (default) or ollama
EDNA_LLM_PROVIDER=lmstudio
EDNA_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
EDNA_LMSTUDIO_MODEL=
EDNA_OLLAMA_BASE_URL=http://localhost:11434
EDNA_OLLAMA_MODEL=qwen2.5:27b

# HTTP ports (api_bridge Settings)
EDNA_API_PORT=10942
EDNA_UI_PORT=10943

# MCP registry: mirrors Claude Desktop mcpServers (NOT fleet auto-discovery)
# Override path if Claude config lives elsewhere:
# CLAUDE_DESKTOP_CONFIG=C:\Users\YOU\AppData\Roaming\Claude\claude_desktop_config.json

# Optional safety filter for family-facing deployments (Track B).
# Comma-separated server names from Claude config. Omit = load all enabled entries.
# EDNA_MCP_ALLOWLIST=plex-mcp,tapo-camera-mcp,mywienerlinien-mcp,memops

# Track B — Edna Media Concierge (PRD.md). "orchestrator" (default) keeps the
# full MCP-fleet chat; "concierge" narrows chat to the three Plex tools.
EDNA_MODE=orchestrator

# Plex connection (RECIPE-EDNA-V1.md). Token: Plex web UI -> any item -> Get Info ->
# View XML -> copy X-Plex-Token from the URL. Client name must match what shows up
# under server.clients() / the device's Plex app settings, e.g. "Wohnzimmer TV".
EDNA_PLEX_URL=http://localhost:32400
EDNA_PLEX_TOKEN=
EDNA_PLEX_DEFAULT_CLIENT=Wohnzimmer TV

# Phase 2 — email-mcp adapter (concierge REST /api/concierge/email/*)
# EDNA_EMAIL_MCP_URL=http://127.0.0.1:10813
# EDNA_EMAIL_MCP_USER=sandra
# EDNA_EMAIL_MCP_PASSWORD=vienna2026
# EDNA_CONCIERGE_TOOLS=plex,email,news

# Phase 3 — aiwatcher digest + speech-mcp TTS
# EDNA_AIWATCHER_MCP_URL=http://127.0.0.1:10946
# EDNA_SPEECH_MCP_URL=http://127.0.0.1:10909

# Phase 4 — Telegram bot (uv sync --extra telegram)
# EDNA_TELEGRAM_TOKEN=
# EDNA_ALLOWED_IDS=123456789
# EDNA_USERS_FILE=users.json

# Voice notes (RECIPE Step 5): uv sync --extra voice
# EDNA_WHISPER_MODEL=large-v3-turbo
# EDNA_WHISPER_DEVICE=cuda
# EDNA_WHISPER_COMPUTE_TYPE=int8
# EDNA_WHISPER_LANGUAGE=de
